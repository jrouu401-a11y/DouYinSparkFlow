[Unit]
Description=DouYin Spark Flow daily delivery windows

[Timer]
Unit=douyin-spark-flow.service
OnCalendar=*-*-* 08:00:00 Asia/Shanghai
OnCalendar=*-*-* 08:30:00 Asia/Shanghai
OnCalendar=*-*-* 09:00:00 Asia/Shanghai
OnCalendar=*-*-* 09:30:00 Asia/Shanghai
Persistent=true
AccuracySec=1min
RandomizedDelaySec=0

[Install]
WantedBy=timers.target
